// The producer's test project for Osysharp.PrepaidCredits — a language school that sells lesson packs: students hold them,
// the front desk spends them when a student comes to a lesson, the owner sells and corrects them, and a parent books
// lessons for a child who never signs in (a managed account of Osysharp.UserAccounts).
app PrepaidCreditsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.PrepaidCredits@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
